<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_company_form" model="ir.ui.view">
            <field name="name">res.company.form.inherit.sign_criipto</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page string="Criipto" name="criipto_sign">
                        <group>
                            <group>
                                <field name="criipto_domain"/>
                                <field name="criipto_client_id"/>
                            </group>
                            <group>
                                <field name="criipto_redirect_uri"/>
                                <field name="criipto_client_secret" password="True"/>
                            </group>
                            <button name="get_criipto_client" class="btn btn-primary" type="object" string="Authorize Criipto"/>
                        </group>


                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>