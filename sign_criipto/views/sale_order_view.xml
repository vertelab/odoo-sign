<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_order_form" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sign_criipto</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[last()]" position="after">
                    <button name="action_create_signature" string="Create Signature" type="object"/>
                </xpath>

                <field name="partner_shipping_id" position="after">
                    <field name="criipto_signature_order_id" options="{'no_create': True}" groups="sale_management.group_sale_order_template"/>
                </field>
            </field>
        </record>

        <record id="sale_order_form_view" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sign_criipto</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sign_sale_order_template.sale_order_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='signer_ids']/list/field[last()]" position="after">
                    <field name="criipto_signature_id" readonly="1" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>