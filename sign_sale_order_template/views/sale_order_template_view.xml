<odoo>
    <data>
        <record id="sale_order_template_form_view" model="ir.ui.view">
            <field name="name">sale.order.template</field>
            <field name="model">sale.order.template</field>
            <field name="inherit_id" ref="sale_management.sale_order_template_view_form" />
            <field name="arch" type="xml">
                <field name="journal_id" position="after">
                    <field name="sign_template_id" options="{'no_create':True}"/>
                </field>
            </field>
        </record>

        <record id="sign_oca_template_form_view" model="ir.ui.view">
            <field name="name">sign.oca.template</field>
            <field name="model">sign.oca.template</field>
            <field name="inherit_id" ref="sign_oca.sign_oca_template_form_view" />
            <field name="arch" type="xml">
                <field name="ask_location" position="after">
                    <field name="signing_option"/>
                </field>
            </field>
        </record>

        <record id="sale_order_form_view" model="ir.ui.view">
            <field name="name">sale.order</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <button name="action_quotation_send" position="before">
                    <button name="action_generate_sign_request" string="Sign" class="btn btn-primary" type="object" invisible="signed_by_sales_person"/>
                </button>
                <field name="user_id" position="after">
                    <field name="signed_by_sales_person"/>
                </field>
                <xpath expr="//page[@name='customer_signature']//field[@name='signed_by']" position="before">
                    <field name="sign_request_id"/>
                    <field name="signed_doc"/>
                    <field name="signer_ids">
                        <list>
                            <field name="role_id"/>
                            <field name="partner_id"/>
                            <field name="signed_on"/>
                            <field name="signature"/>
                        </list>
                    </field>
                </xpath>
            </field>
        </record>
    </data>
</odoo>