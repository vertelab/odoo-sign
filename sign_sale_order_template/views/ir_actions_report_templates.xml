<odoo>
    <data>
        <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
            <xpath expr='//t[@t-call="web.external_layout"]/div[hasclass("page")]/div[last()]' position="after">
                <div class="oe_structure last-page">
                    <div class="row justify-content-between mt-8">
                        <t t-foreach="doc.sign_request_id.signer_ids" t-as="signer">
                            <div class="col-4" t-if="signer.signature">
                                <div class="text-center">
                                    <strong>Signature</strong>
                                </div>
                                <img t-att-src="image_data_uri(signer.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                                <div class="text-center">
                                    <span t-field="signer.partner_id.name">Oscar Morgan</span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </xpath>

