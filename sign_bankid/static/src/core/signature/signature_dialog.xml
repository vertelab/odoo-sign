<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.SignatureDialog" t-inherit="web.SignatureDialog" t-inherit-mode="extension">
        <xpath expr="//div" position="replace">
            <t t-if="props.signing_option == 'bankid'">
                <BankIDSignature t-props="bankIDSignatureProps"/>
            </t>
            <t t-else="">
                <div>
                    <NameAndSignature t-props="nameAndSignatureProps"/>
                    <div class="mt16 small">By clicking Adopt &amp; Sign, I agree that the chosen signature/initials will be a valid electronic representation of my hand-written signature/initials for all purposes when it is used on documents, including legally binding contracts.</div>
                </div>
            </t>
        </xpath>

        <xpath expr="//t[@t-set-slot='footer']" position="attributes">
            <attribute name="t-if">props.signing_option !== 'bankid'</attribute>
        </xpath>
    </t>

    <!-- Template for BankID Signature -->
    <t t-name="sign_bankid.BankIDSignature">
        <div class="o_web_bankid_signature">
            <form id="bankid_sign" class="modal-content">
                <main class="modal-body">
                    <!-- Always show SSN input when not initiated -->
                    <div t-if="!state.bankidInitiated" id="bankid_init_view">
                        <div class="form-group">
                            <label class="form-label" for="ssn">Personal Number</label>
                            <input type="text"
                                   name="ssn"
                                   class="form-control"
                                   placeholder="YYYYMMDD-NNNN"
                                   t-model="state.bankidSSN"
                                   t-att-value="state.bankidSSN"/>
                            <small class="form-text text-muted">Enter your Swedish personal number</small>
                        </div>
                        <div t-if="state.ssnError" class="alert alert-danger mt-2">
                            <t t-esc="state.ssnError"/>
                        </div>
                    </div>

                    <!-- BankID signing view - show when initiated -->
                    <div t-if="state.bankidInitiated" id="bankid_signing_view">
                        <div id="bankid_status" t-att-class="'alert text-center mb-4 ' + (state.statusClass || 'alert-info')">
                            <t t-esc="state.bankidStatus"/>
                        </div>

                        <div class="row">
                            <div class="col-md-6 text-center mb-4">
                                <h5>Scan with BankID app</h5>
                                <div id="qrcode-container" class="d-flex justify-content-center">
                                    <!-- QR code will be inserted here -->
                                </div>
                            </div>

                            <div class="col-md-6 text-center mb-4">
                                <h5>Or launch app on this device</h5>
                                <a t-if="state.bankidData"
                                   t-att-href="state.bankidData.autoStartUrl"
                                   class="btn btn-primary mt-3">
                                    <i class="fa fa-mobile-phone"/> Launch BankID App
                                </a>
                                <p class="small mt-2">
                                    Click the button above if you have the BankID app installed on this device.
                                </p>
                            </div>
                        </div>
                    </div>
                </main>
            </form>
        </div>

        <t t-set-slot="footer">
            <div class="mt-4 d-flex gap-2 justify-content-end">
                <!-- Show Sign button when not initiated -->
                <button t-if="!state.bankidInitiated"
                        type="button"
                        class="btn btn-primary"
                        t-on-click="initiateBankID">
                    <i class="fa fa-pencil"/> Sign with BankID
                </button>


                <!-- Always show regular Cancel -->
                <button type="button" class="btn btn-secondary" t-on-click="cancelBankID">
                    Cancel
                </button>
            </div>
        </t>
    </t>
</templates>