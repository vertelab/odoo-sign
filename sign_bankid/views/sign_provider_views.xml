<odoo>
    <data>
        <record id="view_sign_provider_form_bankid" model="ir.ui.view">
            <field name="name">sign.provider.form.inherit.bankid</field>
            <field name="model">sign.provider</field>
            <field name="inherit_id" ref="sign_vrtl.sign_provider_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='provider_setup']" position="inside">
                    <group string="BankID Setup" invisible="code != 'bankid'">
                        <field name="cert_file"/>

                    </group>

                </xpath>
            </field>
        </record>
    </data>
</odoo>