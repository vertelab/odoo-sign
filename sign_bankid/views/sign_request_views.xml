        <field name="model">vrtl.sign.request</field>
        <field name="inherit_id" ref="sign_vrtl.vrtl_sign_request_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='signers']" position="after">
                <page string="BankID" name="bankid" invisible="sign_provider_code != 'bankid'">
                    <group>
                        <group>
                            <field name="bankid_order_ref"/>

                        </group>
                        <group>
                            <field name="bankid_order_ref"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
