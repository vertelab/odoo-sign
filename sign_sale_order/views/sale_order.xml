<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>
        <record id="view_sale_order_form" model="ir.ui.view">
            <field name="name">sale.order.form (in project_task_sign_oca)</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="groups_id" eval="[(6, 0, [ref('sign_oca.sign_oca_group_user')])]"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button type="object" name="action_view_sign_requests" class="oe_stat_button" icon="fa-file-text-o" attrs="{'invisible': [('sign_request_count', '=', 0)]}">
                        <field name="sign_request_count" widget="statinfo" string="Sign Requests"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>
