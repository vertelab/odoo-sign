<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">

    <!-- Onboardingskurs: Signering i Vertel.
         Lektionerna ligger i data/slide_slides_s1..s5.xml och skapas darfor
         aven i produktionsdatabaser som kors utan demodata. -->
    <record id="slide_channel_sign" model="slide.channel">
        <field name="name">Signering i Vertel</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="enroll">public</field>
        <field name="channel_type">training</field>
        <field name="allow_comment" eval="True"/>
        <field name="promote_strategy">latest</field>
        <field name="is_published" eval="True"/>
        <field name="description">Lär dig skicka dokument för signering, följa status och arkivera det signerade. Kursen beskriver signeringsflödet i appen Signering.</field>
    </record>

</data></odoo>
